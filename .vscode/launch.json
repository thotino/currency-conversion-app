{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach NestJS",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "localRoot": "${workspaceFolder}/api",
      "remoteRoot": "/app",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/api/dist/**/*.js"]
    }
  ]
}
